# CDM — variables de entorno de ejemplo de la API (apps/api, `cdm.config.settings`).
# Solo nombres y placeholders. El archivo real .env NUNCA se commitea (ver .gitignore).
# La API lee `.env` de la raíz del repo o de apps/api. En AWS Lambda los valores
# llegan como variables de entorno definidas por Terraform (infrastructure/terraform).

# --- Entorno ---
CDM_ENV=dev                      # dev | test | prod
CDM_LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL local de Docker Compose) ---
CDM_DATABASE_URL=postgresql+psycopg://cdm:cdm@localhost:5432/cdm

# --- CORS: orígenes exactos del frontend, separados por coma (nunca * en la nube) ---
CDM_CORS_ORIGINS=http://localhost:4200

# --- Auth (Amazon Cognito) ---
# Con User Pool configurado, toda petición exige un JWT firmado por Cognito.
CDM_COGNITO_REGION=us-east-1
CDM_COGNITO_USER_POOL_ID=
CDM_COGNITO_CLIENT_ID=
# Solo desarrollo local SIN User Pool: acepta los tokens sin firma del modo mock del
# frontend (environment.ts sin clientId). Prohibido con CDM_ENV=prod.
CDM_AUTH_MOCK_ENABLED=false

# --- S3 ---
CDM_S3_BUCKET_NAME=cdm-documents-dev
CDM_S3_REGION=us-east-1
# Solo local: emulador S3 de compose.yaml (con AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY=test). Vacío en AWS real.
# CDM_S3_ENDPOINT_URL=http://localhost:9000
CDM_UPLOAD_URL_EXPIRES_IN_SECONDS=900
CDM_MAX_UPLOAD_SIZE_BYTES=52428800
