# CDM — variables de entorno de ejemplo.
# Solo nombres y placeholders. El archivo real .env NUNCA se commitea (ver .gitignore).

# --- Entorno ---
CDM_ENV=dev                      # dev | test | prod

# --- Base de datos (PostgreSQL local de Docker Compose) ---
CDM_DATABASE_URL=postgresql+psycopg://cdm:cdm@localhost:5432/cdm

# --- API ---
CDM_API_HOST=0.0.0.0
CDM_API_PORT=8000
CDM_API_PREFIX=/api/v1
CDM_CORS_ORIGINS=http://localhost:4200

# --- Auth (Amazon Cognito) ---
CDM_COGNITO_REGION=us-east-1
CDM_COGNITO_USER_POOL_ID=
CDM_COGNITO_CLIENT_ID=

# --- S3 ---
CDM_AWS_REGION=us-east-1
CDM_S3_BUCKET=
CDM_PRESIGNED_URL_TTL_SECONDS=900
CDM_UPLOAD_SESSION_TTL_MINUTES=30
CDM_MAX_FILE_SIZE_MB=50

# --- SQS (worker) ---
CDM_SQS_QUEUE_URL=
CDM_SQS_MAX_RECEIVES=3

# --- Observabilidad ---
CDM_LOG_LEVEL=INFO
